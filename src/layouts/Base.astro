---
import '../styles/global.css';
import { url, CONTACT_URL, getWorks } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  // Hide the logo in the navigation (the home page shows the logo animation instead)
  hideBrand?: boolean;
}

const {
  title,
  description = 'Team Dalton は、ドルトン東京学園中等部・高等部の生徒からなる総合デザインチームです。',
  image = '/media/team-dalton-cover.webp',
  hideBrand = false,
} = Astro.props;

const pageTitle = title ? `${title} | Team Dalton` : 'Team Dalton';
const ogImage = Astro.site ? new URL(url(image), Astro.site).href : url(image);
const path = Astro.url.pathname;
const publishedWorks = (await getWorks()).filter((work) => !work.data.draft);

// "© 2026" in the first year, then a range such as "© 2026–2028" (updates whenever the site is rebuilt).
const FIRST_YEAR = 2026;
const currentYear = new Date().getFullYear();
const copyrightYears = currentYear > FIRST_YEAR ? `${FIRST_YEAR}–${currentYear}` : `${FIRST_YEAR}`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;700;800&family=Noto+Sans+JP:wght@400;500;700;800&family=Playfair+Display:wght@600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <slot name="backdrop" />

    <div class="site-header">
      <nav class="top-nav container" aria-label="メインメニュー">
        {
          !hideBrand && (
            <a class="brand" href={url('/')} aria-label="Team Dalton ホーム">
              <img src={url('/media/logo.webp')} alt="Team Dalton" width="1200" height="239" />
            </a>
          )
        }
        <div class="top-nav-right">
          <a class="top-nav-link" href={url('/about/')} aria-current={path.includes('/about/') ? 'page' : undefined}>
            About
          </a>
          <div class="top-nav-item">
            <a class="top-nav-link" href={url('/works/')} aria-current={path.includes('/works/') ? 'page' : undefined}>
              Works
            </a>
            <div class="top-nav-dropdown">
              {
                publishedWorks.map((work) => (
                  <a class="top-nav-link" href={url(`/works/${work.id}/`)}>
                    {work.data.title}
                  </a>
                ))
              }
              <a class="top-nav-link" href={url('/works/')}>All Works</a>
            </div>
          </div>
          <a class="top-nav-link" href={CONTACT_URL} target="_blank" rel="noopener">Contact</a>
        </div>
      </nav>
    </div>

    <div class="scroll-progress" aria-hidden="true">
      <span class="scroll-progress-fill"></span>
    </div>

    <slot />

    <div class="lightbox" id="lightbox" aria-hidden="true">
      <img src="" alt="" />
    </div>

    <footer class="footer container">
      <div class="footer-main">
        <a class="footer-brand" href={url('/')} aria-label="Team Dalton ホーム">
          <img src={url('/media/logo.webp')} alt="Team Dalton" width="1200" height="239" loading="lazy" />
        </a>
        <div class="footer-links">
          <a href={url('/about/')}>About</a>
          <a href={url('/works/')}>Works</a>
          <a href={CONTACT_URL} target="_blank" rel="noopener">Contact</a>
          <a href="#top">Top</a>
        </div>
      </div>
      <div class="footer-legal">
        <p>© {copyrightYears} Team Dalton. All rights reserved.</p>
        <p>Not an official Minecraft product. Not approved by or associated with Mojang or Microsoft.</p>
      </div>
    </footer>

    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
