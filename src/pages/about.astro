---
import Base from '../layouts/Base.astro';
import { url, CONTACT_URL } from '../lib/url';

const principal = {
  name: 'Taichi Sudoh',
  photo: '/media/principal.webp',
  bio: 'Team Dalton 創設者。ドルトン東京学園高等部2年。「まちづくり」のテーマを幅広く追求。マインクラフトカップ活動を5年間続けている他、学校の6つのハウスの１つである「Oハウス」リーダー。また、東京都中高生政策参画プロジェクトメンバー。',
  linkedin: 'https://www.linkedin.com/in/taichi-sudoh001/',
};

// Oldest first. Add a new year at the end.
const history = [
  { year: 2023, events: ['東京都奨励賞', 'SuSHi Tech Tokyo 2024 開会式に小池都知事と共に参列'] },
  { year: 2024, events: ['東京都代表', '全国大会学校賞'] },
  { year: 2025, events: ['東京都2年連続代表', '全国大会奨励賞'] },
];
---

<Base title="About" hideBrand description="Team Dalton は、マインクラフトカップへの出場をきっかけに立ち上げられた、ドルトン東京学園の生徒を中心とした有志組織です。">
  <header class="about-banner" id="top">
    <img src={url('/media/team-dalton-cover.webp')} alt="Team Dalton の作品" />
    <span class="scroll-cue" aria-hidden="true">Scroll</span>
  </header>

  <main>
    <section class="section is-after-banner container tracked-section" id="team">
      <p class="eyebrow section-eyebrow">About</p>
      <h1 class="section-title">Team Dalton</h1>
      <p class="lead reveal">
        「Team Dalton」は、ドルトン東京学園の生徒を中心とした有志組織で、街を作って全国の若者と競い合う「マインクラフトカップ」への出場をきっかけに立ち上げられました。将来の街のあるべき姿を追求しながら、これからも様々な活動を進めていきます。
      </p>
    </section>

    <section class="section is-tight container tracked-section" id="leader">
      <h2 class="section-title">Principal</h2>
      <div class="leader-card reveal">
        <img class="leader-photo" src={url(principal.photo)} alt={principal.name} width="480" height="480" loading="lazy" />
        <div class="leader-body">
          <div class="leader-heading">
            <h3 class="leader-name">{principal.name}</h3>
            <a class="leader-link" href={principal.linkedin} target="_blank" rel="noopener" aria-label={`${principal.name} の LinkedIn`}>
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
                ></path>
              </svg>
            </a>
          </div>
          <p>{principal.bio}</p>
        </div>
      </div>
    </section>

    <section class="section is-tight container tracked-section history" id="awards">
      <div>
        <h2 class="section-title">History &amp; Awards</h2>
      </div>
      <ol class="timeline">
        {
          history.map((entry) => (
            <li class="timeline-item reveal">
              <h3 class="timeline-year">{entry.year}</h3>
              <ul class="timeline-events">
                {entry.events.map((event) => (
                  <li>{event}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="section container tracked-section" id="contact">
      <h2 class="section-title">Contact</h2>
      <p class="lead reveal">Team Dalton へのご連絡は、以下のフォームからお願いいたします。</p>
      <div class="hero-actions reveal">
        <a class="cta is-primary" href={CONTACT_URL} target="_blank" rel="noopener">お問い合わせフォームを開く</a>
      </div>
    </section>
  </main>
</Base>
